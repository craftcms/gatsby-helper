{
  "name": "craftcms/gatsby-helper",
  "description": "Plugin for enabling support for the Gatsby Craft CMS source plugin.",
  "type": "craft-plugin",
  "keywords": [
    "craft",
    "cms",
    "craftcms",
    "craft-plugin",
    "gatsby",
    "laravel"
  ],
  "support": {
    "docs": "https://github.com/craftcms/gatsby-helper/blob/3.x/README.md",
    "issues": "https://github.com/craftcms/gatsby-helper/issues",
    "source": "https://github.com/craftcms/gatsby-helper",
    "rss": "https://github.com/craftcms/gatsby-helper/commits/3.x.atom"
  },
  "license": "MIT",
  "authors": [
    {
      "name": "Pixel & Tonic",
      "homepage": "https://pixelandtonic.com/"
    }
  ],
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require": {
    "php": "^8.5",
    "craftcms/cms": "^6.0.0-beta.1"
  },
  "require-dev": {
    "larastan/larastan": "^3.13",
    "laravel/pint": "^1.22",
    "orchestra/testbench": "^11.0",
    "pestphp/pest": "^5.0",
    "pestphp/pest-plugin-laravel": "^5.0",
    "phpstan/phpstan": "^2.1"
  },
  "autoload": {
    "psr-4": {
      "CraftCms\\GatsbyHelper\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "CraftCms\\GatsbyHelper\\Tests\\": "tests/",
      "CraftCms\\Cms\\Database\\Factories\\": "vendor/craftcms/cms/database/Factories/"
    }
  },
  "extra": {
    "class": "CraftCms\\GatsbyHelper\\Plugin",
    "name": "Gatsby Helper",
    "handle": "gatsby-helper",
    "developerUrl": "https://craftcms.com/",
    "documentationUrl": "https://github.com/craftcms/gatsby-helper/blob/3.x/README.md"
  },
  "scripts": {
    "check-cs": "pint --test",
    "fix-cs": "pint",
    "phpstan": "phpstan --memory-limit=1G",
    "test": "pest"
  },
  "config": {
    "platform": {
      "php": "8.5"
    },
    "allow-plugins": {
      "craftcms/plugin-installer": true,
      "pestphp/pest-plugin": true
    }
  }
}
